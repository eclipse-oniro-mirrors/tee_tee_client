#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")
module_output_path = "tee_client/tee_client"

##############################fuzztest##########################################
ohos_fuzztest("LibteecVendorInvokeCommandFuzzTest") {
  module_out_path = module_output_path
  fuzz_config_file = "../libteecvendorinvokecommand_fuzzer"
  include_dirs = [
    "../../../../interfaces/inner_api",
    "../../../../frameworks/libteec_vendor",
    "../../../../services/authentication",
    "../../../../frameworks/include",
    "../../../../frameworks/include/standard/",
    "../../../../frameworks/include/standard/teec_vendor",
  ]
  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]
  defines = [
    "LIB_TEEC_VENDOR",
    "CONFIG_LOG_REPORT",
  ]
  sources = [
    "libteecvendorinvokecommand_fuzzer.cpp",
    "../../../../frameworks/libteec_vendor/load_sec_file.c",
    "../../../../frameworks/libteec_vendor/tee_client_api.c",
    "../../../../frameworks/libteec_vendor/tee_client_app_load.c",
    "../../../../frameworks/libteec_vendor/tee_client_socket.c",
    "../../../../frameworks/tee_file/tee_file.c",
    "../../../../services/authentication/tee_auth_common.c",
    "../../../../services/authentication/tee_get_native_cert.c",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "safwk:system_ability_fwk",
    "bounds_checking_function:libsec_shared",
    "hisysevent:libhisysevent",
  ]
}
